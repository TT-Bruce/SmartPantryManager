<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7F2">

    <TextView
        android:id="@+id/txtRecipeDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipe Name"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#285943"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Required Ingredients"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/txtRecipeIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredients will appear here"
        android:textSize="16sp"
        android:paddingBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cooking Method"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/txtRecipeMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking instructions will appear here"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

    </ScrollView>

    <Button
        android:id="@+id/btnBackToRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Recipes" />

</LinearLayout>
