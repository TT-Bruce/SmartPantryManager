<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7F2">

    <TextView
        android:id="@+id/txtFormHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#285943"
        android:paddingBottom="24dp" />

    <EditText
        android:id="@+id/editIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name (e.g. Rice)"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/editIngredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g. 2)"
        android:inputType="numberDecimal"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/editIngredientUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (e.g. kg, cups, items)"
        android:inputType="textCapSentences"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnSaveIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Ingredient"
        android:layout_marginTop="24dp" />

</LinearLayout>
